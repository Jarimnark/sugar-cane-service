DATABASE_URL=postgres://app:app@localhost:5432/sugarcane?sslmode=disable
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sugarcane
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
PORT=8080

# OAuth
OAUTH_REDIRECT_BASE=http://localhost:8080
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# MCP endpoint (optional; leave MCP_TOKEN empty to disable /mcp)
# MCP_TOKEN: random secret, at least 32 chars (e.g. `openssl rand -hex 32`)
# MCP_USER_ID: id of the Hopbu user the MCP tools act as
MCP_TOKEN=
MCP_USER_ID=
