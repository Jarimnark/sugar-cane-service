# ── Infra (Caddy + deploy) ───────────────────────────────────────────────────
# Dev runs over plain HTTP against the droplet IP — no domain, no TLS.
# When you buy a domain, set DOMAIN here, uncomment the DOMAIN BLOCK in
# caddy/Caddyfile, and remove `auto_https off` from the global block.
DOMAIN=
ENVIRONMENT=staging
ACME_EMAIL=
# ACME_CA=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

# ── Images ───────────────────────────────────────────────────────────────────
GITHUB_REPOSITORY=jarimnark/sugar-cane-service
WEB_IMAGE=jarimnark/sugar-cane-web
APP_TAG=develop
WEB_TAG=develop

# ── Ports (bound to 127.0.0.1 inside compose; Caddy fronts them) ────────────
APP_PORT=8080
WEB_PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=  # generate: openssl rand -base64 32
POSTGRES_DB=sugarcane_staging
DATABASE_URL=postgres://app:CHANGE_ME@postgres:5432/sugarcane_staging?sslmode=disable

# ── Storage (MinIO on the droplet) ────────────────────────────────────────────
MINIO_ROOT_USER=  # generate: openssl rand -base64 24
MINIO_ROOT_PASSWORD=  # generate: openssl rand -base64 32
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sugarcane-staging
S3_ACCESS_KEY=  # same as MINIO_ROOT_USER
S3_SECRET_KEY=  # same as MINIO_ROOT_PASSWORD

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8080
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGIN=http://152.42.174.244
OAUTH_REDIRECT_BASE=http://152.42.174.244/api
FRONTEND_URL=http://152.42.174.244

# ── OAuth (optional in dev — leave blank to disable social login) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://152.42.174.244/api
