# ──────────────────────────────────────────────────────────────────────────────
# SugarCane Caddy config — IP mode (dev)
# When a domain lands, swap this out for a Domain Block that terminates TLS.
# ──────────────────────────────────────────────────────────────────────────────

{
	auto_https off
}

:80 {
	handle_path /api/* {
		reverse_proxy {$CADDY_INGRESS_API}
	}
	handle {
		reverse_proxy {$CADDY_INGRESS_WEB}
	}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
