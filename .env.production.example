# ── Infra (Caddy + deploy) ───────────────────────────────────────────────────
# Set DOMAIN once purchased, then uncomment the DOMAIN BLOCK in caddy/Caddyfile
# and remove `auto_https off` from its global block to turn on Let's Encrypt.
DOMAIN=
ENVIRONMENT=prod
ACME_EMAIL=
# ACME_CA=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

# ── Images ───────────────────────────────────────────────────────────────────
GITHUB_REPOSITORY=jarimnark/sugar-cane-service
WEB_IMAGE=jarimnark/sugar-cane-web
APP_TAG=latest
WEB_TAG=latest

# ── Ports (bound to 127.0.0.1; Caddy fronts them) ────────────────────────────
APP_PORT=8080
WEB_PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=  # generate: openssl rand -base64 32
POSTGRES_DB=sugarcane_prod
DATABASE_URL=  # postgres://app:<pw>@postgres:5432/sugarcane_prod?sslmode=disable

# ── Storage (DigitalOcean Spaces) ─────────────────────────────────────────────
# Create the bucket via Pulumi (set sugarcane:useObjectStorage=true on prod stack).
# Access keys are generated manually in DO dashboard: API > Spaces Keys.
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_BUCKET=sugarcane-prod-uploads
S3_ACCESS_KEY=  # paste from DO Spaces Keys
S3_SECRET_KEY=  # paste from DO Spaces Keys

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8080
COOKIE_DOMAIN=  # yourdomain.com
COOKIE_SECURE=true
CORS_ORIGIN=  # https://yourdomain.com
OAUTH_REDIRECT_BASE=  # https://api.yourdomain.com
FRONTEND_URL=  # https://yourdomain.com

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=  # https://api.yourdomain.com
